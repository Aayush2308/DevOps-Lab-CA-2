# Copy this to .env and fill in real values. NEVER commit .env to git.

# GitHub Container Registry (set in GitHub Actions Secrets)
GHCR_TOKEN=your_github_pat_here

# App settings
CATALOG_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002
ORDERS_SERVICE_URL=http://localhost:8003
INVENTORY_SERVICE_URL=http://localhost:8004
PAYMENTS_SERVICE_URL=http://localhost:8005

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme
