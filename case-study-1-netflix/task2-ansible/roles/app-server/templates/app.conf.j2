# {{ app_name }} — Application Configuration
# Generated by Ansible on {{ ansible_date_time.date }}
# DO NOT edit manually — managed by Ansible role: app-server
# Host: {{ inventory_hostname }} | Environment: {{ app_env }}

[service]
name       = {{ app_name }}
port       = {{ app_port }}
environment = {{ app_env }}
user       = {{ app_user }}

[logging]
log_dir    = {{ log_dir }}
log_level  = INFO
log_format = %(asctime)s %(levelname)s %(name)s %(message)s

[health]
health_endpoint = /health
metrics_endpoint = /metrics
check_interval  = 30s

[resilience]
# Netflix pattern: circuit breaker settings
fallback_enabled = true
failure_threshold = 3
timeout_seconds   = 2
